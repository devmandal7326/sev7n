# Sev7n Clothing Store (सेव7न) Environment Variables Example

# Server Port (Runs on 3000 for AI Studio environment)
PORT=3000

# Admin Master Password for Store Management Console
ADMIN_PASSWORD="sev7n@admin2026"

# Razorpay Payment Gateway Credentials (Optional: enables live payments instead of demo flow)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Supabase Production Backend Configuration (Optional: for direct cloud DB synchronization)
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# GEMINI_API_KEY: Required if AI Studio server-side capabilities are invoked
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"
